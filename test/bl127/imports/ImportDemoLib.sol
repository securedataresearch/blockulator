                    let mm := mulmod(rh, rh, not(0))
                    let sh := or(shl(2, sub(sub(mm, p0), lt(mm, p0))), shr(254, p0))
                    let sl := shl(2, p0)
                    p0 := mul(rh, rl)
                    mm := mulmod(rh, rl, not(0))
                    let q1 := sub(sub(mm, p0), lt(mm, p0))
                    // 2 rh rl = (q1, p0) 2: at 2^-510 its top part is (q1, p0) 2^3 / 2^256

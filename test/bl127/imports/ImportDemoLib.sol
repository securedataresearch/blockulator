                    sl := add(sl, c)
                    sh := add(add(sh, shr(253, q1)), lt(sl, c))
                    p0 := mul(rl, rl)
                    mm := mulmod(rl, rl, not(0))
                    c := shr(254, sub(sub(mm, p0), lt(mm, p0)))
                    sl := add(sl, c)
                    sh := add(sh, lt(sl, c))
                    c := add(rl, or(shl(sub(256, i), sh), shr(i, sl)))
                    rh := add(add(rh, shr(i, sh)), lt(c, rl))
                    rl := c

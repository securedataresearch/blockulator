                { let pl := mul(p, x) let ph := mulmod(p, x, not(0)) p := add(sub(sub(sub(ph, pl), lt(ph, pl)), mul(ng, p)), 0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa52) }

                let lo := w19_mulwu(m, 0x3bc3887eeaa2ed9ac49b25eeb82d7c167d52173cc1895213f897f5e06a7be736)
                p0 := add(p0, lo)
                p1 := add(p1, lt(p0, lo))
                let sh := sub(236, u)
                f := and(w19_shr512(p1, p0, sh), 0x3fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)

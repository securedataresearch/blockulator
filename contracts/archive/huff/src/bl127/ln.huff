/// @title BL127 Natural Logarithm
/// @notice ln(x) for 127.128 fixed-point arithmetic using log2-based algorithm
/// @dev Requires: log2.huff and arithmetic.huff must be included before this file
///
/// Algorithm:
///   ln(x) = log2(x) * ln(2)
///
/// Gas: ~3,800 (log2 ~3,500 + MUL ~130 + overhead)
/// Precision: ~126 fractional bits

/// @notice Compute ln(x) using log2(x) * ln(2)
/// @dev takes(1) returns(1)
/// Stack input:  [x] (127.128 format, must be > 0)
/// Stack output: [ln(x)] (127.128 format, signed)
/// Note: Guards (zero, negative, x==1) are handled inside BL127_LOG2
#define fn BL127_LN() = takes(1) returns(1) {
    BL127_LOG2()               // [log2(x)]
    
    // log2 returns 0 for x==1, x==0, x<0 -- check if we got 0
    dup1 iszero ln_zero jumpi
    
    [LN2_BL127]                // [LN2, log2(x)]
    BL127_MUL()                // [ln(x)]
    ln_done jump
    
    ln_zero:
    
    ln_done:
}

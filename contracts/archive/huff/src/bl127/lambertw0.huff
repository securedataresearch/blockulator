/// @title BL127 Lambert W0 Function
/// @notice Lambert W0 (principal branch) for 127.128 fixed-point numbers
/// @dev Requires: constants.huff, primitives.huff, arithmetic.huff, exp.huff

// ============================================================================
// Lambert W0 (Principal Branch) - Helper Macros
// ============================================================================

/// @notice Dense lookup table with linear interpolation for Lambert W0
/// @dev takes(1) returns(2)
/// Stack input:  [x] where 1 <= x < 64
/// Stack output: [w0, x] where w0 ≈ W(x) via interpolation
/// Uses 64-entry table W(1)..W(64) with linear interpolation
/// Gives ~16-20 bits of accuracy for 1 <= x < 64
/// Note: Caller must ensure 1 <= x < 64 via MSB check before calling
#define fn LAMBERTW0_LUT_INTERP() = takes(1) returns(2) {
    // [x]
    // Store all 64 constants in memory
    // W(1)-W(16) at 0x200-0x3e0
    [LAMBERTW0_W1]   0x200 mstore
    [LAMBERTW0_W2]   0x220 mstore
    [LAMBERTW0_W3]   0x240 mstore
    [LAMBERTW0_W4]   0x260 mstore
    [LAMBERTW0_W5]   0x280 mstore
    [LAMBERTW0_W6]   0x2a0 mstore
    [LAMBERTW0_W7]   0x2c0 mstore
    [LAMBERTW0_W8]   0x2e0 mstore
    [LAMBERTW0_W9]   0x300 mstore
    [LAMBERTW0_W10]  0x320 mstore
    [LAMBERTW0_W11]  0x340 mstore
    [LAMBERTW0_W12]  0x360 mstore
    [LAMBERTW0_W13]  0x380 mstore
    [LAMBERTW0_W14]  0x3a0 mstore
    [LAMBERTW0_W15]  0x3c0 mstore
    [LAMBERTW0_W16]  0x3e0 mstore
    // W(17)-W(32) at 0x400-0x5e0
    [LAMBERTW0_W17]  0x400 mstore
    [LAMBERTW0_W18]  0x420 mstore
    [LAMBERTW0_W19]  0x440 mstore
    [LAMBERTW0_W20]  0x460 mstore
    [LAMBERTW0_W21]  0x480 mstore
    [LAMBERTW0_W22]  0x4a0 mstore
    [LAMBERTW0_W23]  0x4c0 mstore
    [LAMBERTW0_W24]  0x4e0 mstore
    [LAMBERTW0_W25]  0x500 mstore
    [LAMBERTW0_W26]  0x520 mstore
    [LAMBERTW0_W27]  0x540 mstore
    [LAMBERTW0_W28]  0x560 mstore
    [LAMBERTW0_W29]  0x580 mstore
    [LAMBERTW0_W30]  0x5a0 mstore
    [LAMBERTW0_W31]  0x5c0 mstore
    [LAMBERTW0_W32]  0x5e0 mstore
    // W(33)-W(48) at 0x600-0x7e0
    [LAMBERTW0_W33]  0x600 mstore
    [LAMBERTW0_W34]  0x620 mstore
    [LAMBERTW0_W35]  0x640 mstore
    [LAMBERTW0_W36]  0x660 mstore
    [LAMBERTW0_W37]  0x680 mstore
    [LAMBERTW0_W38]  0x6a0 mstore
    [LAMBERTW0_W39]  0x6c0 mstore
    [LAMBERTW0_W40]  0x6e0 mstore
    [LAMBERTW0_W41]  0x700 mstore
    [LAMBERTW0_W42]  0x720 mstore
    [LAMBERTW0_W43]  0x740 mstore
    [LAMBERTW0_W44]  0x760 mstore
    [LAMBERTW0_W45]  0x780 mstore
    [LAMBERTW0_W46]  0x7a0 mstore
    [LAMBERTW0_W47]  0x7c0 mstore
    [LAMBERTW0_W48]  0x7e0 mstore
    // W(49)-W(64) at 0x800-0x9e0
    [LAMBERTW0_W49]  0x800 mstore
    [LAMBERTW0_W50]  0x820 mstore
    [LAMBERTW0_W51]  0x840 mstore
    [LAMBERTW0_W52]  0x860 mstore
    [LAMBERTW0_W53]  0x880 mstore
    [LAMBERTW0_W54]  0x8a0 mstore
    [LAMBERTW0_W55]  0x8c0 mstore
    [LAMBERTW0_W56]  0x8e0 mstore
    [LAMBERTW0_W57]  0x900 mstore
    [LAMBERTW0_W58]  0x920 mstore
    [LAMBERTW0_W59]  0x940 mstore
    [LAMBERTW0_W60]  0x960 mstore
    [LAMBERTW0_W61]  0x980 mstore
    [LAMBERTW0_W62]  0x9a0 mstore
    [LAMBERTW0_W63]  0x9c0 mstore
    [LAMBERTW0_W64]  0x9e0 mstore
    
    // Extract integer part: idx = floor(x), guaranteed in [1, 63] by caller
    dup1 [BL127_SHIFT] shr           // [idx, x]
    
    // Load w_lo = W(idx) and w_hi = W(idx+1)
    // LUT is 0-indexed: W(1) at 0x200, W(2) at 0x220, etc.
    // So W(idx) is at 0x200 + (idx-1)*32, W(idx+1) is at 0x200 + idx*32
    dup1 0x01 swap1 sub              // [idx-1, idx, x]
    0x05 shl 0x200 add mload         // [w_lo = W(idx), idx, x]
    swap1 dup1                       // [idx, idx, w_lo, x]
    0x05 shl 0x200 add mload         // [w_hi = W(idx+1), idx, w_lo, x]
    swap1 pop                        // [w_hi, w_lo, x]
    
    // Linear interpolation: w0 = w_lo + (w_hi - w_lo) * frac
    dup2 dup2 sub                    // [delta = w_hi - w_lo, w_hi, w_lo, x]
    dup4 [MASK128] and               // [frac, delta, w_hi, w_lo, x]
    BL127_MUL()                      // [delta * frac, w_hi, w_lo, x]
    dup3 add                         // [w0 = w_lo + delta*frac, w_hi, w_lo, x]
    swap2 pop pop                    // [w0, x]
}

/// @notice Newton-Raphson iteration step for Lambert W0
/// @dev takes(2) returns(2)
/// Stack input:  [x, w]
/// Stack output: [x, w']
/// 
/// Newton-Raphson for f(w) = w*e^w - x:
///   w' = w - (w*e^w - x) / (e^w*(w+1))
///
/// Per step: 1 exp, 2 muls, 1 div, 1 BL127_SUB
/// Quadratic convergence: bits double each step
/// Gas: ~2000 per step (simpler than Halley, fewer rounding errors)
#define fn LAMBERTW0_NR_STEP() = takes(2) returns(2) {
    // stack in:  [x, w]
    // stack out: [x, w']
    dup2 BL127_EXP()        // [e, x, w]
    dup3 dup2 BL127_MUL()   // [we, e, x, w]       -- p = w*e
    dup3 swap1 sub           // [s, e, x, w]         -- s = we - x (native sub)
    swap1                    // [e, s, x, w]
    dup4 [ONE_BL127] add     // [t, e, s, x, w]     -- t = w + 1
    BL127_MUL()              // [d, s, x, w]         -- d = e * (w+1)
    BL127_DIV()              // [c, x, w]            -- c = s / d
    dup3 swap1 BL127_SUB()   // [w-c, x, w]          -- w' = w - c
    swap2 pop                // [x, w']
}

/// @notice Fritsch-Shafer-Crowley 4th-order iteration step for Lambert W0
/// @dev takes(2) returns(2)
/// Stack input:  [x, w]
/// Stack output: [x, w']
/// 
/// FSC formula: r = (w*e^w - x) / (e^w*(w+1))
///              w' = w - r * (1 + r / (2*(w+1)))
///
/// Per step: 1 exp, 3 muls, 2 divs
/// Quartic convergence: bits quadruple each step
/// Gas: ~3300-3800 per step (faster convergence than NR)
#define fn LAMBERTW0_FSC_STEP() = takes(2) returns(2) {
    // [x, w]
    dup2 [ONE_BL127] add          // [wp1, x, w]             wp1 = w + 1
    dup3 BL127_EXP()              // [ew, wp1, x, w]
    dup4 dup2 BL127_MUL()         // [wew, ew, wp1, x, w]    wew = w * e^w
    dup4 BL127_SUB()              // [s, ew, wp1, x, w]      s = w*e^w - x
    swap1 dup3 BL127_MUL()        // [ew_wp1, s, wp1, x, w]  denom = e^w * (w+1)

    // r = s / denom: DIV takes [b, a] returns a/b, need [ew_wp1, s]
    BL127_DIV()                   // [r, wp1, x, w]          r = s / denom

    // FSC correction: r_fsc = r * (1 + r / (2*(w+1)))
    dup1                          // [r, r, wp1, x, w]
    dup3 0x01 shl                 // [2*wp1, r, r, wp1, x, w]
    BL127_DIV()                   // [r/(2*wp1), r, wp1, x, w]
    [ONE_BL127] add               // [1+r/(2*wp1), r, wp1, x, w]
    BL127_MUL()                   // [r_fsc, wp1, x, w]

    // Stack: [r_fsc, wp1, x, w]
    // Goal:  [x, w - r_fsc]
    swap3                         // [w, wp1, x, r_fsc]
    swap3                         // [r_fsc, wp1, x, w]
    swap2                         // [x, wp1, r_fsc, w]
    swap1 pop                     // [x, r_fsc, w]
    swap2 sub swap1               // [x, w - r_fsc]
}

/// @notice Iacono-Boyd iteration step for Lambert W0 (cancellation-free)
/// @dev takes(2) returns(2)
/// Stack input:  [x, w]
/// Stack output: [x, w']
/// 
/// Iacono-Boyd formula: w' = w * (1 + ln(x / w)) / (1 + w)
///
/// Per step: 2 divs, 1 ln, 1 mul
/// Linear convergence but NO catastrophic cancellation
/// Gas: ~5000 per step (expensive, use as finisher only)
/// Use after FSC/NR has gotten close to eliminate cancellation noise
#define fn LAMBERTW0_IB_STEP() = takes(2) returns(2) {
    // [x, w]
    dup2                    // [w, x, w]
    dup2                    // [x, w, x, w]
    swap1 BL127_DIV()       // [x/w, x, w]
    BL127_LN()              // [ln(x/w), x, w]
    [ONE_BL127] add         // [1+ln(x/w), x, w]
    dup3 BL127_MUL()        // [w*(1+ln(x/w)), x, w]
    dup3 [ONE_BL127] add    // [1+w, numerator, x, w]
    BL127_DIV()             // [w', x, w]
    swap2 pop               // [x, w']
}

// ============================================================================
// Lambert W0 Path Function (Single Path)
// ============================================================================

/// @notice LUT path: use LUT interpolation with 2 FSC + 1 IB for all x > 0
/// @dev takes(1) returns(1)
/// Stack input:  [x] where x > 0
/// Stack output: [w] where w*e^w = x
#define fn LAMBERTW0_LUT_PATH() = takes(1) returns(1) {
    // [x]
    LAMBERTW0_LUT_INTERP()           // [w0, x]
    swap1                            // [x, w0]
    LAMBERTW0_FSC_STEP()             // [x, w1]
    LAMBERTW0_FSC_STEP()             // [x, w2]
    LAMBERTW0_IB_STEP()              // [x, w']
    pop                              // [w']
}

// ============================================================================
// Lambert W0 (Principal Branch)
// ============================================================================

/// @notice Lambert W0 using dense LUT + FSC + Iacono-Boyd finisher
/// @dev takes(1) returns(1)
/// Stack input:  [x] (127.128, must be >= -1/e)
/// Stack output: [w] where w*e^w = x
/// 
/// Algorithm (single-path):
///   1. Edge cases: domain check, W(0)=0
///   2. Dense LUT + interpolation: W(1)..W(64) for all x > 0 (~16-20 bits)
///   3. FSC + IB iteration: 2 FSC steps + 1 IB finisher for convergence
///
/// The LUT interpolation works for all x > 0:
///   - For x < 1: interpolates between W(0)=0 and W(1)≈0.567
///   - For 1 <= x <= 64: interpolates between W(floor(x)) and W(ceil(x))
///   - For x > 64: uses W(64) as initial guess (less accurate, but FSC converges)
///
/// Supported range: 0 < x <= 64 (optimal precision)
/// Extended range: x > 64 works but with reduced initial guess quality
///
/// FSC: Quartic convergence (bits quadruple), ~3500 gas/step
/// IB: Cancellation-free finisher, ~5000 gas/step
///
/// Gas: ~12,000-14,000 (single path, no branching)
/// Precision: ~38 decimal digits (128 fractional bits) for x <= 64
#define fn BL127_LAMBERT_W0() = takes(1) returns(1) {
    // ========== Edge Cases ==========
    // Domain check: x >= -1/e
    dup1 [INV_E_BL127] BL127_NEG() swap1 slt
    lambertw0_domain_error jumpi

    // W(0) = 0
    dup1 iszero lambertw0_zero jumpi
    
    // Shortcut guards for integer inputs 1-10 (use existing LUT values)
    dup1 [ONE_BL127] eq sc_lw0_1 jumpi
    dup1 [SC_IN_INT_2] eq sc_lw0_2 jumpi
    dup1 [SC_IN_INT_3] eq sc_lw0_3 jumpi
    dup1 [SC_IN_INT_4] eq sc_lw0_4 jumpi
    dup1 [SC_IN_INT_5] eq sc_lw0_5 jumpi

    // ========== Single Path: LUT + Iteration ==========
    // All valid inputs go through LUT interpolation + FSC + IB
    LAMBERTW0_LUT_PATH()
    lambertw0_done jump
    
    // Shortcut landing pads
    sc_lw0_1: pop [LAMBERTW0_W1] lambertw0_done jump
    sc_lw0_2: pop [LAMBERTW0_W2] lambertw0_done jump
    sc_lw0_3: pop [LAMBERTW0_W3] lambertw0_done jump
    sc_lw0_4: pop [LAMBERTW0_W4] lambertw0_done jump
    sc_lw0_5: pop [LAMBERTW0_W5] lambertw0_done jump

    lambertw0_zero:
    lambertw0_done jump

    lambertw0_domain_error:
    pop 0x00

    lambertw0_done:
}

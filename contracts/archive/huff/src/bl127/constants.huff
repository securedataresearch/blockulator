/// @title BL127 Constants
/// @notice Constants for signed fixed-point arithmetic using two's complement
/// @dev Format: 128 integer bits + 128 fractional bits in a single uint256
///      Value represented = word / 2^128
///      Sign handled via two's complement (bit 255 is sign bit)

// ONE_BL127: The value 1.0 in 127.128 format (1 << 128)
#define constant ONE_BL127 = 0x100000000000000000000000000000000

// HALF_BL127: The value 0.5 in 127.128 format (1 << 127)
#define constant HALF_BL127 = 0x80000000000000000000000000000000

// FIXED18_SCALE: 10^18 (for converting to/from 18-decimal fixed-point)
#define constant FIXED18_SCALE = 0xDE0B6B3A7640000

// MASK128: Mask for lower 128 bits (2^128 - 1)
#define constant MASK128 = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF

// FRAC_MASK: Mask for fractional 128 bits (2^128 - 1)
#define constant FRAC_MASK = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF

// INT_MASK: Mask for integer 128 bits (upper 128 bits)
#define constant INT_MASK = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00000000000000000000000000000000

// MAX_UINT256: Maximum uint256 value (2^256 - 1)
#define constant MAX_UINT256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// BL127_SHIFT: Alias for FRAC_BITS (128) - used for bit position calculations
#define constant BL127_SHIFT = 0x80

// ============================================================================
// Transcendental Base Constants
// ============================================================================

// LN2_BL127: ln(2) in 127.128 format
#define constant LN2_BL127 = 0x00000000000000000000000000000000b17217f7d1cf79abc9e3b39803f2f6af

// INV_LN2_BL127: 1/ln(2) in 127.128 format
#define constant INV_LN2_BL127 = 0x0000000000000000000000000000000171547652b82fe1777d0ffda0d23a7d11

// SQRT2_BL127: sqrt(2) in 127.128 format
#define constant SQRT2_BL127 = 0x000000000000000000000000000000016a09e667f3bcc908b2fb1366ea957d3e

// INV_E_BL127: 1/e in 127.128 format (≈ 0.36787944117144232159552377016146)
#define constant INV_E_BL127 = 0x000000000000000000000000000000005e2d58d8b3bcdf1abadec7829054f90d

// ============================================================================
// EXP Overflow/Underflow Thresholds
// ============================================================================

// EXP_OVERFLOW_THRESHOLD: max input for exp (88.0 in 127.128)
#define constant EXP_OVERFLOW_THRESHOLD = 0x0000000000000000000000000000005800000000000000000000000000000000

// EXP_UNDERFLOW_THRESHOLD: min input for exp (-88.0 in 127.128)
#define constant EXP_UNDERFLOW_THRESHOLD = 0xffffffffffffffffffffffffffffffa800000000000000000000000000000000

// EXP2_OVERFLOW_THRESHOLD: 127 in BL127 format (2^127 is max representable)
#define constant EXP2_OVERFLOW_THRESHOLD = 0x0000000000000000000000000000007f00000000000000000000000000000000

// EXP2_UNDERFLOW_THRESHOLD: -128 in BL127 format (2^-128 underflows to 0)
#define constant EXP2_UNDERFLOW_THRESHOLD = 0xffffffffffffffffffffffffffffff8000000000000000000000000000000000


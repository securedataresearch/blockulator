        // Compute cbrt(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_CBRT()           // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    lerp_jump:
        pop
        // Compute lerp(a, b, t) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        0x44 calldataload      // [t_fixed18, b_bl127, a_bl127]
        BL127_FROM_FIXED18()   // [t_bl127, b_bl127, a_bl127]
        BL127_LERP()           // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    hypot_jump:
        pop
        // Compute hypot(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_HYPOT()          // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    sign_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_SIGN()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    floor_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_FLOOR()          // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    ceil_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_CEIL()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    frac_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_FRAC()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    cbrt_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_CBRT()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    lerp_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        0x44 calldataload      // [t_bl127, b_bl127, a_bl127]
        BL127_LERP()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    hypot_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        BL127_HYPOT()          // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    round_jump:
        pop
        // Compute round(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_ROUND()          // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    round_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_ROUND()          // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    log2up_jump:
        pop
        // Compute log2Up(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_LOG2_UP()        // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    log2up_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_LOG2_UP()        // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    gcd_jump:
        pop
        // Compute gcd(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_GCD()            // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    gcd_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        BL127_GCD()            // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    factorial_jump:
        pop
        // Compute factorial(n) with fixed18 I/O
        0x04 calldataload      // [n_fixed18]
        BL127_FROM_FIXED18()   // [n_bl127]
        BL127_FACTORIAL()      // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    factorial_raw_jump:
        pop
        0x04 calldataload      // [n_bl127]
        BL127_FACTORIAL()      // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    lambertw0_jump:
        pop
        // Compute lambertW0(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_LAMBERT_W0()     // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    lambertw0_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_LAMBERT_W0()     // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    // Debug: FSC step in isolation
    lambertw0_dbg_fsc_jump:
        pop
        0x04 calldataload      // [x]
        0x24 calldataload      // [w, x]
        swap1                  // [x, w]
        LAMBERTW0_FSC_STEP()   // [x, w']
        swap1                  // [w', x]
        0x00 mstore            // w'
        0x20 mstore            // x
        0x40 0x00 return

    // Debug: Iacono-Boyd step in isolation
    lambertw0_dbg_ib_jump:
        pop
        0x04 calldataload      // [x]
        0x24 calldataload      // [w, x]
        swap1                  // [x, w]
        LAMBERTW0_IB_STEP()    // [x, w']
        swap1                  // [w', x]
        0x00 mstore            // w'
        0x20 mstore            // x
        0x40 0x00 return

    // Debug: Isolated LUT interpolation test
    // Takes x_bl127, returns (w0, x)
    lambertw0_dbg_lut_interp_isolated_jump:
        pop
        0x04 calldataload        // [x]
        LAMBERTW0_LUT_INTERP()   // [w0, x]
        0x00 mstore              // w0
        0x20 mstore              // x
        0x40 0x00 return

    // Debug: Isolated Carmack guess test
    // Takes (msb, x), returns (w0, x)
    lambertw0_dbg_carmack_isolated_jump:
        pop
        0x04 calldataload        // [msb]
        0x24 calldataload        // [x, msb]
        swap1                    // [msb, x]
        
        // Inline the macro with diagnostics
        dup1 0x80 swap1 sub      // [k, msb, x]
        dup1                     // [k, k, msb, x] - save k
        dup1 MSB()               // [log2k, k, k, msb, x]
        dup1                     // [log2k, log2k, k, k, msb, x] - save log2k
        swap2                    // [k, log2k, log2k, k, msb, x]
        sub                      // [k-log2k, log2k, k, msb, x]
        dup1                     // [k-log2k, k-log2k, log2k, k, msb, x] - save diff
        0x80 shl                 // [w0, k-log2k, log2k, k, msb, x]
        
        // Return (w0, k-log2k, log2k, k, msb, x)
        0x00 mstore              // w0
        0x20 mstore              // k-log2k
        0x40 mstore              // log2k
        0x60 mstore              // k
        0x80 mstore              // msb
        0xa0 mstore              // x
        0xc0 0x00 return

}


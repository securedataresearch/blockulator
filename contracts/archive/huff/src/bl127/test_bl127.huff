        pop
        0x04 calldataload      // [x_bl127]
        0x24 calldataload      // [lo_bl127, x_bl127]
        0x44 calldataload      // [hi_bl127, lo_bl127, x_bl127]
        BL127_CLAMP()          // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    avg_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        BL127_AVG()            // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    zeroFloorSub_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        BL127_ZERO_FLOOR_SUB() // [result_bl127]

/// @title BL127 Exponential Functions
/// @notice 2^x and e^x for 127.128 fixed-point arithmetic
/// @dev Requires: arithmetic.huff and constants.huff must be included before this file
///
/// Algorithm for 2^x:
///   1. Split x into integer k and fractional frac parts
///   2. Compute 2^frac using degree-22 minimax polynomial (Horner evaluation)
///   3. Scale by 2^k (bit shift)
///   4. For negative x: compute 2^(-|x|) directly
///
/// Gas: ~2,500 for 22 Horner steps
/// Precision: ~131 bits (max error < 2^-131)

// ============================================================================
// Horner Step Function for Polynomial Evaluation
// ============================================================================

/// @notice Single Horner step: result = result * x + coeff
/// @dev Stack: [coeff, result, x] -> [result * x + coeff, x]
/// @dev Converted to function to save ~234 bytes (22 call sites)
#define fn HORNER_STEP() = takes(3) returns(2) {
    // Input: [coeff, result, x]
    swap1              // [result, coeff, x]
    dup3               // [x, result, coeff, x]
    BL127_MUL()        // [result*x, coeff, x]
    add                // [result*x+coeff, x]
}

// ============================================================================
// EXP2_FRAC: Compute 2^frac for frac in [0, 1) using minimax polynomial
// ============================================================================

/// @notice Compute 2^frac where frac is the fractional part (128 bits)
/// @dev takes(1) returns(1)
/// Stack input:  [frac] (lower 128 bits of the base-2 exponent, in BL127 format)
/// Stack output: [2^frac] (127.128 format)
/// Algorithm: Horner evaluation of degree-22 minimax polynomial
///   P(f) = C22*f^22 + C21*f^21 + ... + C1*f + C0
///   Horner: (((...((C22*f + C21)*f + C20)*f + ...)*f + C1)*f + C0
#define macro EXP2_FRAC() = takes(1) returns(1) {
    // Input: [frac]
    // Start with highest coefficient C22
    [EXP2_C22]                // [result = C22, frac]
    
    // 21 Horner steps using the HORNER_STEP function
    [EXP2_C21] HORNER_STEP()
    [EXP2_C20] HORNER_STEP()
    [EXP2_C19] HORNER_STEP()
    [EXP2_C18] HORNER_STEP()
    [EXP2_C17] HORNER_STEP()
    [EXP2_C16] HORNER_STEP()
    [EXP2_C15] HORNER_STEP()
    [EXP2_C14] HORNER_STEP()
    [EXP2_C13] HORNER_STEP()
    [EXP2_C12] HORNER_STEP()
    [EXP2_C11] HORNER_STEP()
    [EXP2_C10] HORNER_STEP()
    [EXP2_C9] HORNER_STEP()
    [EXP2_C8] HORNER_STEP()
    [EXP2_C7] HORNER_STEP()
    [EXP2_C6] HORNER_STEP()
    [EXP2_C5] HORNER_STEP()
    [EXP2_C4] HORNER_STEP()
    [EXP2_C3] HORNER_STEP()
    [EXP2_C2] HORNER_STEP()
    [EXP2_C1] HORNER_STEP()
    
    // Final Horner step: result = result * frac + C0 (consume frac)
    swap1 BL127_MUL() [EXP2_C0] add
    
    // Stack: [2^frac]
}

// ============================================================================
// BL127_EXP2_CORE: Core 2^x logic without bounds checking
// ============================================================================

/// @notice Core 2^x computation (no guards - caller must validate input)
/// @dev takes(1) returns(1)
/// Stack input:  [x] (127.128 format, signed, must be in [-128, 127])
/// Stack output: [2^x] (127.128 format)
#define fn BL127_EXP2_CORE() = takes(1) returns(1) {
    // Check for zero
    dup1 iszero exp2c_zero jumpi
    
    dup1 IS_NEGATIVE() exp2c_negative jumpi
    
    // Positive x: split into integer and fractional parts
    dup1 [BL127_SHIFT] sar     // [k_int, x]
    swap1 [MASK128] and        // [frac, k_int]
    EXP2_FRAC()                // [2^frac, k_int]
    swap1 shl                  // [result]
    exp2c_done jump
    
    exp2c_negative:
    NEGATE()                   // [|x|]
    dup1 [BL127_SHIFT] shr     // [|k_int|, |x|]
    swap1 [MASK128] and        // [frac_of_neg, |k_int|]
    
    dup1 iszero exp2c_neg_no_frac jumpi
    
    [ONE_BL127] sub            // [1-frac, |k_int|]
    EXP2_FRAC()                // [2^(1-frac), |k_int|]
    swap1 0x01 add             // [|k_int|+1, 2^(1-frac)]
    shr                        // [result]
    exp2c_done jump
    
    exp2c_neg_no_frac:
    pop                        // [|k_int|]
    [ONE_BL127] swap1 shr      // [result]
    exp2c_done jump
    
    exp2c_zero:
    pop
    [ONE_BL127]
    
    exp2c_done:
}

// ============================================================================
// BL127_EXP2: Compute 2^x with bounds checking
// ============================================================================

/// @notice Compute 2^x using minimax polynomial (guarded entry point)
/// @dev takes(1) returns(1)
/// Stack input:  [x] (127.128 format, signed)
/// Stack output: [2^x] (127.128 format)
#define fn BL127_EXP2() = takes(1) returns(1) {
    [EXP2_OVERFLOW_THRESHOLD] dup2 sgt exp2_overflow jumpi
    [EXP2_UNDERFLOW_THRESHOLD] dup2 slt exp2_underflow jumpi
    
    BL127_EXP2_CORE()
    exp2_done jump
    
    exp2_overflow:
    pop
    [MAX_UINT256]
    exp2_done jump
    
    exp2_underflow:
    pop
    0x00
    
    exp2_done:
}

// ============================================================================
// BL127_EXP: Compute e^x for 127.128 fixed-point x
// ============================================================================

/// @notice Compute e^x using exp2(x * 1/ln(2))
/// @dev takes(1) returns(1)
/// Stack input:  [x] (127.128 format, signed)
/// Stack output: [exp(x)] (127.128 format)
///
/// Gas: ~2,700
/// Precision: ~131 bits
#define fn BL127_EXP() = takes(1) returns(1) {
    dup1 iszero exp_zero jumpi
    
    [EXP_OVERFLOW_THRESHOLD] dup2 sgt    // [x > 88, x]
    exp_overflow jumpi
    [EXP_UNDERFLOW_THRESHOLD] dup2 slt   // [x < -88, x]
    exp_underflow jumpi
    
    // exp(x) = 2^(x * log2(e))
    [INV_LN2_BL127]            // [INV_LN2, x]
    BL127_MUL()                // [x * INV_LN2]
    
    // After EXP bounds check, x*INV_LN2 is guaranteed within EXP2 range
    BL127_EXP2_CORE()          // [exp(x)]
    exp_done jump
    
    exp_overflow:
    pop
    [MAX_UINT256]
    exp_done jump
    
    exp_underflow:
    pop
    0x00
    exp_done jump
    
    exp_zero:
    pop
    [ONE_BL127]
    
    exp_done:
}

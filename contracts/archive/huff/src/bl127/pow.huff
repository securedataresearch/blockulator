/// @title BL127 Power Function
/// @notice x^y for 127.128 fixed-point arithmetic
/// @dev Requires: log2.huff, exp.huff, and arithmetic.huff must be included before this file
///
/// Algorithm:
///   x^y = 2^(y * log2(x))
///
/// Edge cases:
///   - y == 0: return 1 (x^0 = 1 for all x, including 0^0 = 1 by convention)
///   - x == 0: return 0 (0^y = 0 for y != 0)
///   - x == 1: return 1 (1^y = 1 for all y)
///   - x < 0: revert (fractional powers of negatives are undefined in reals)
///
/// Gas: ~6,500 (log2 ~3,500 + mul ~130 + exp2 ~2,500 + overhead)
/// Precision: ~126 fractional bits (compounded from log2 and exp2 precision)

/// @notice Compute x^y using log2 and exp2
/// @dev takes(2) returns(1)
/// Stack input:  [y, x] (both 127.128 format, signed)
/// Stack output: [x^y] (127.128 format)
#define macro BL127_POW() = takes(2) returns(1) {
    // Stack: [y, x]
    
    // Check if y == 0 (any x^0 = 1)
    dup1 iszero pow_y_zero jumpi
    
    // Check if x == 0 (0^y = 0 for y != 0)
    dup2 iszero pow_x_zero jumpi
    
    // Check if x == 1 (1^y = 1 for all y)
    dup2 [ONE_BL127] eq pow_x_one jumpi
    
    // Check if x < 0 (revert for negative base)
    dup2 IS_NEGATIVE() pow_x_negative jumpi
    
    // Dispatch shortcuts - Y-based
    dup1 [ONE_BL127] eq sc_pow_y1 jumpi        // y=1: return x
    dup1 [SC_IN_INT_2] eq sc_pow_y2 jumpi      // y=2: x*x
    dup1 [SC_IN_INT_3] eq sc_pow_y3 jumpi      // y=3: x*x*x
    dup1 [SC_IN_INT_4] eq sc_pow_y4 jumpi      // y=4: (x*x)*(x*x)
    dup1 [HALF_BL127] eq sc_pow_yh jumpi       // y=0.5: sqrt(x)
    dup1 [SC_IN_FRAC_1_4] eq sc_pow_yq jumpi   // y=0.25: sqrt(sqrt(x))
    dup1 [SC_IN_NEG_1] eq sc_pow_yn1 jumpi     // y=-1: 1/x
    
    // Dispatch shortcuts - X-based
    dup2 [SC_IN_INT_2] eq sc_pow_x2 jumpi      // x=2: exp2(y)
    dup2 [SC_IN_INT_10] eq sc_pow_x10 jumpi    // x=10: exp10(y)
    
    // Main path: x^y = 2^(y * log2(x))
    swap1                      // [x, y]
    BL127_LOG2()               // [log2(x), y]
    BL127_MUL()                // [y * log2(x)]
    BL127_EXP2()               // [2^(y * log2(x)) = x^y]
    pow_done jump
    
    // Shortcut landing pads - Y-based
    sc_pow_y1: pop pow_done jump                                    // return x
    sc_pow_y2: pop dup1 BL127_MUL() pow_done jump                   // x*x
    sc_pow_y3: pop dup1 dup1 BL127_MUL() BL127_MUL() pow_done jump  // x*x*x
    sc_pow_y4: pop dup1 BL127_MUL() dup1 BL127_MUL() pow_done jump  // (x*x)*(x*x)
    sc_pow_yh: pop BL127_SQRT() pow_done jump                       // sqrt(x)
    sc_pow_yq: pop BL127_SQRT() BL127_SQRT() pow_done jump          // sqrt(sqrt(x))
    sc_pow_yn1: pop BL127_INV() pow_done jump                       // 1/x
    
    // Shortcut landing pads - X-based
    sc_pow_x2: swap1 pop BL127_EXP2() pow_done jump                 // 2^y
    sc_pow_x10: swap1 pop BL127_EXP10() pow_done jump               // 10^y
    
    pow_y_zero:
    // y == 0: return 1
    pop pop                    // Clear stack
    [ONE_BL127]                // [1.0]
    pow_done jump
    
    pow_x_zero:
    // x == 0: return 0
    pop pop                    // Clear stack
    0x00                       // [0]
    pow_done jump
    
    pow_x_one:
    // x == 1: return 1
    pop pop                    // Clear stack
    [ONE_BL127]                // [1.0]
    pow_done jump
    
    pow_x_negative:
    // x < 0: revert (fractional powers of negatives are undefined)
    0x00 0x00 revert
    
    pow_done:
}

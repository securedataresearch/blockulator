        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_GAVG()           // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    log10_jump:
        pop
        // Compute log10(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_LOG10()          // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    exp10_jump:
        pop
        // Compute exp10(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_EXP10()          // [result_bl127]

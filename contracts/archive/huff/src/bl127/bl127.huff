        0x00 mstore
        0x20 0x00 return
    
    pow_jump:
        pop
        // Compute pow(x, y) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        0x24 calldataload      // [y_fixed18, x_bl127]
        BL127_FROM_FIXED18()   // [y_bl127, x_bl127]
        BL127_POW()            // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]

        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    inv_jump:
        pop
        // Compute inv(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_INV()            // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    min_jump:
        pop
        // Compute min(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_MIN()            // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    max_jump:
        pop
        // Compute max(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_MAX()            // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    clamp_jump:
        pop
        // Compute clamp(x, lo, hi) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        0x24 calldataload      // [lo_fixed18, x_bl127]
        BL127_FROM_FIXED18()   // [lo_bl127, x_bl127]
        0x44 calldataload      // [hi_fixed18, lo_bl127, x_bl127]
        BL127_FROM_FIXED18()   // [hi_bl127, lo_bl127, x_bl127]
        BL127_CLAMP()          // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    avg_jump:
        pop
        // Compute avg(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_AVG()            // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    zeroFloorSub_jump:
        pop
        // Compute zeroFloorSub(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_ZERO_FLOOR_SUB() // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    dist_jump:
        pop
        // Compute dist(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]

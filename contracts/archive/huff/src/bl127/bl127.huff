    floor_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_FLOOR()          // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    ceil_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_CEIL()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    frac_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_FRAC()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    cbrt_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_CBRT()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    lerp_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        0x44 calldataload      // [t_bl127, b_bl127, a_bl127]
        BL127_LERP()           // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    hypot_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        BL127_HYPOT()          // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    round_jump:
        pop
        // Compute round(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_ROUND()          // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    round_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_ROUND()          // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    log2up_jump:
        pop
        // Compute log2Up(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_LOG2_UP()        // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    log2up_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_LOG2_UP()        // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    gcd_jump:
        pop
        // Compute gcd(a, b) with fixed18 I/O
        0x04 calldataload      // [a_fixed18]
        BL127_FROM_FIXED18()   // [a_bl127]
        0x24 calldataload      // [b_fixed18, a_bl127]
        BL127_FROM_FIXED18()   // [b_bl127, a_bl127]
        BL127_GCD()            // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    gcd_raw_jump:
        pop
        0x04 calldataload      // [a_bl127]
        0x24 calldataload      // [b_bl127, a_bl127]
        BL127_GCD()            // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    factorial_jump:
        pop
        // Compute factorial(n) with fixed18 I/O
        0x04 calldataload      // [n_fixed18]
        BL127_FROM_FIXED18()   // [n_bl127]
        BL127_FACTORIAL()      // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    factorial_raw_jump:
        pop
        0x04 calldataload      // [n_bl127]
        BL127_FACTORIAL()      // [result_bl127]
        0x00 mstore
        0x20 0x00 return
    
    lambertw0_jump:
        pop
        // Compute lambertW0(x) with fixed18 I/O
        0x04 calldataload      // [x_fixed18]
        BL127_FROM_FIXED18()   // [x_bl127]
        BL127_LAMBERT_W0()     // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    lambertw0_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]
        BL127_LAMBERT_W0()     // [result_bl127]
        0x00 mstore
        0x20 0x00 return

}


        BL127_SQRT()           // [result_bl127]
        BL127_TO_FIXED18()     // [result_fixed18]
        0x00 mstore
        0x20 0x00 return
    
    sqrt_raw_jump:
        pop
        0x04 calldataload      // [x_bl127]

/// @title BL127 Transcendental Utility Functions
/// @notice Additional transcendental operations built on core functions
/// @dev Requires: constants.huff, arithmetic.huff, log2.huff, exp.huff, sqrt.huff

// ============================================================================
// Constants for Base-10 Operations
// ============================================================================

// log2(10) in 127.128 format ≈ 3.321928094887362347870319429489390175864831393024580612054756395815934776608
#define constant LOG2_10_BL127 = 0x000000000000000000000000000000035269e12f346e2bf924afdbfd36bf6d33

// 1/log2(10) in 127.128 format ≈ 0.301029995663981195213738894724493026768189881462108541310427461127108189274
#define constant INV_LOG2_10_BL127 = 0x000000000000000000000000000000004d104d427de7fbcc47c4acd605be48bc

// ============================================================================
// Geometric Mean
// ============================================================================

/// @notice Geometric mean of two 127.128 fixed-point numbers
/// @dev takes(2) returns(1)
/// Stack input:  [b, a] (b on top)
/// Stack output: [sqrt(a * b)]
/// Formula: gavg(a, b) = sqrt(a * b)
/// Gas: ~600-700 (mul + sqrt)
/// Note: Both inputs should be non-negative for real result
#define macro BL127_GAVG() = takes(2) returns(1) {
    // Stack: [b, a]
    BL127_MUL()                // [a * b]
    BL127_SQRT()               // [sqrt(a * b)]
}

// ============================================================================
// Base-10 Logarithm
// ============================================================================

/// @notice Base-10 logarithm of a 127.128 fixed-point number
/// @dev takes(1) returns(1)
/// Stack input:  [x]
/// Stack output: [log10(x)]
/// Formula: log10(x) = log2(x) / log2(10)
/// Gas: ~1100-1200 (log2 + mul)
/// Precision: ~38 decimal digits (inherits from log2)
#define macro BL127_LOG10() = takes(1) returns(1) {
    // Stack: [x]
    BL127_LOG2()               // [log2(x)]
    [INV_LOG2_10_BL127]        // [1/log2(10), log2(x)]
    BL127_MUL()                // [log10(x)]
}

// ============================================================================
// Base-10 Exponential
// ============================================================================

/// @notice Base-10 exponential: 10^x
/// @dev takes(1) returns(1)
/// Stack input:  [x]
/// Stack output: [10^x]
/// Formula: 10^x = 2^(x * log2(10))
/// Gas: ~1000-1100 (mul + exp2)
/// Precision: ~38 decimal digits (inherits from exp2)
/// Range: x must be in range where 10^x doesn't overflow/underflow
///        Roughly -38 < x < 38 for safe operation
/// NOTE: This function does not perform overflow/underflow checks. Callers are
///       responsible for range validation. BL127_EXP2 has built-in guards.
#define macro BL127_EXP10() = takes(1) returns(1) {
    // Stack: [x]
    [LOG2_10_BL127]            // [log2(10), x]
    BL127_MUL()                // [x * log2(10)]
    BL127_EXP2()               // [2^(x * log2(10)) = 10^x]
}

// ============================================================================
// Cube Root
// ============================================================================

// 1/3 in 127.128 format
#define constant ONE_THIRD_BL127 = 0x0000000000000000000000000000000055555555555555555555555555555555

/// @notice Cube root via pow(x, 1/3), handles negative inputs
/// @dev takes(1) returns(1)
#define macro BL127_CBRT() = takes(1) returns(1) {
    dup1 iszero cbrt_zero jumpi
    dup1 IS_NEGATIVE() cbrt_negative jumpi
    
    // Perfect cube shortcuts (positive)
    dup1 [SC_IN_INT_8] eq cbrt_8 jumpi     // cbrt(8) = 2
    dup1 [SC_IN_INT_27] eq cbrt_27 jumpi   // cbrt(27) = 3
    dup1 [SC_IN_INT_64] eq cbrt_64 jumpi   // cbrt(64) = 4
    
    [ONE_THIRD_BL127] BL127_POW()
    cbrt_done jump
    
    cbrt_negative:
    BL127_ABS() [ONE_THIRD_BL127] BL127_POW() NEGATE()
    cbrt_done jump
    
    // Perfect cube landing pads
    cbrt_8: pop [SC_IN_INT_2] cbrt_done jump
    cbrt_27: pop [SC_IN_INT_3] cbrt_done jump
    cbrt_64: pop [SC_IN_INT_4] cbrt_done jump
    
    cbrt_zero:
    cbrt_done:
}

// ============================================================================
// Log2 Ceiling
// ============================================================================

/// @notice ceil(log2(x)) for positive x
/// @dev takes(1) returns(1)
/// Fast path for powers of 2 (exact result via MSB), polynomial + ceil for others
#define macro BL127_LOG2_UP() = takes(1) returns(1) {
    // Stack: [x]
    // Power-of-2 check: x & (x - 1) == 0 means exactly one bit is set
    dup1 dup1 0x01 swap1 sub   // [x-1, x, x]
    and                         // [x & (x-1), x]
    log2up_not_pow2 jumpi       // [x]  (jump if x & (x-1) != 0)

    // Exact power of 2: log2(x) = msb - 128, already an integer
    MSB()                       // [msb]
    0x80 swap1 sub              // [msb - 128]
    0x80 shl                    // [(msb - 128) << 128] = result in BL127
    log2up_done jump

    log2up_not_pow2:
    BL127_LOG2() BL127_CEIL()   // ceil(log2(x))

    log2up_done:
}

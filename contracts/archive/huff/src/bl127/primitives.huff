/// @title BL127 Primitives
/// @notice Low-level macros for safe comparisons, negation, and bit operations
/// @dev These macros encode the correct EVM operand order to prevent bugs.
///      EVM comparison/subtraction operand order:
///        - SUB pops [a, b] and pushes (a - b), so "a on top" means a - b
///        - LT/GT/SLT/SGT pop [a, b] and push (a < b) or (a > b)
///      Common pattern: to check "x < THRESHOLD", use: THRESHOLD swap1 lt
///      This file provides named macros for the most error-prone patterns.
/// @dev Requires: constants.huff must be included before this file

// ============================================================================
// Sign and Negation
// ============================================================================

/// @notice Check if top-of-stack is negative (signed comparison)
/// @dev takes(1) returns(1)
/// Stack input:  [x]
/// Stack output: [x < 0] (1 if negative, 0 otherwise)
#define macro IS_NEGATIVE() = takes(1) returns(1) {
    0x00 swap1 slt    // [x < 0]
}

/// @notice Negate top-of-stack (two's complement)
/// @dev takes(1) returns(1)
/// Stack input:  [x]
/// Stack output: [-x]
/// SUB pops [a, b] and pushes (a - b), so we need [0, x] on stack for 0 - x
#define macro NEGATE() = takes(1) returns(1) {
    0x00 sub          // [0 - x = -x]
}

// ============================================================================
// Arithmetic Helper Functions
// ============================================================================

/// @notice Newton-Raphson sqrt step: y = (y + x/y) / 2
/// @dev takes(2) returns(2)
/// Stack input:  [y, x]
/// Stack output: [y_new, x]
/// Requires BL127_DIV_UNSIGNED to be defined (sqrt always operates on positive values)
/// @dev Converted to function to save ~93 bytes (7 call sites)
#define fn NEWTON_SQRT_STEP() = takes(2) returns(2) {
    dup1 dup3 swap1            // [y, x, y, x]
    BL127_DIV_UNSIGNED()       // [x/y, y, x]
    add 0x01 shr               // [y_new, x]
}

// ============================================================================
// Most Significant Bit (MSB) Binary Search
// ============================================================================

/// @notice Find the position of the most significant bit using binary search
/// @dev takes(1) returns(1)
/// Stack input:  [x] (any uint256 > 0)
/// Stack output: [msb] (bit position, 0-255)
/// Algorithm: Binary search checking 128, 64, 32, 16, 8, 4, 2, 1 bit ranges
/// Gas: ~150 (8 conditional jumps)
///
/// Comparison pattern used throughout: "THRESHOLD swap1 lt" = "x < THRESHOLD"
/// If x >= THRESHOLD, we don't jump, we add bits and shift.
#define fn MSB() = takes(1) returns(1) {
    // Binary search for MSB
    // Stack: [x]
    0x00                       // [msb=0, x]
    
    // Check if x >= 2^128 (jump if x < 2^128)
    dup2 0x100000000000000000000000000000000 swap1 lt msb_skip_128 jumpi
    0x80 add swap1 0x80 shr swap1
    msb_skip_128:
    
    // Check if y >= 2^64
    dup2 0x10000000000000000 swap1 lt msb_skip_64 jumpi
    0x40 add swap1 0x40 shr swap1
    msb_skip_64:
    
    // Check if y >= 2^32
    dup2 0x100000000 swap1 lt msb_skip_32 jumpi
    0x20 add swap1 0x20 shr swap1
    msb_skip_32:
    
    // Check if y >= 2^16
    dup2 0x10000 swap1 lt msb_skip_16 jumpi
    0x10 add swap1 0x10 shr swap1
    msb_skip_16:
    
    // Check if y >= 2^8
    dup2 0x100 swap1 lt msb_skip_8 jumpi
    0x08 add swap1 0x08 shr swap1
    msb_skip_8:
    
    // Check if y >= 2^4
    dup2 0x10 swap1 lt msb_skip_4 jumpi
    0x04 add swap1 0x04 shr swap1
    msb_skip_4:
    
    // Check if y >= 2^2
    dup2 0x04 swap1 lt msb_skip_2 jumpi
    0x02 add swap1 0x02 shr swap1
    msb_skip_2:
    
    // Check if y >= 2^1
    dup2 0x02 swap1 lt msb_skip_1 jumpi
    0x01 add swap1 0x01 shr swap1
    msb_skip_1:
    
    // Stack: [msb, y (should be 1)]
    swap1 pop                  // [msb]
}

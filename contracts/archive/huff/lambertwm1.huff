/// @title BL127 Lambert W_{-1} Function (ARCHIVED)
/// @notice Lambert W_{-1}(x) for 127.128 fixed-point arithmetic (secondary branch)
/// @dev Archived: Removed from build due to huffc expanded-source limit (~115KB).
///     Restore by moving back to bl127/ and adding include to bl127.huff/test_bl127.huff.
/// @dev Requires: constants.huff, primitives.huff, arithmetic.huff, ln.huff, exp.huff, lambertw0.huff
///
/// The Lambert W function satisfies: W(x) * exp(W(x)) = x
/// The W_{-1} branch is defined for x in [-1/e, 0) and gives the lower solution.
///
/// Algorithm:
///   1. Domain check: -1/e <= x < 0
///   2. Initial guess: w0 = ln(-x) - ln(-ln(-x))
///   3. Refine with 3 Newton-Raphson steps (reuse LAMBERTW0_NR_STEP)
///
/// Gas: ~3,000-4,000 (2x ln + 3x NR iterations)
/// Precision: ~100+ bits

// ============================================================================
// BL127_LAMBERT_WM1: Compute Lambert W_{-1}(x)
// ============================================================================

/// @notice Compute Lambert W_{-1}(x) for 127.128 fixed-point x
/// @dev takes(1) returns(1)
/// Stack input:  [x] (127.128 format, must be in [-1/e, 0))
/// Stack output: [W_{-1}(x)] (127.128 format, negative)
/// Domain: [-1/e, 0) where -1/e ≈ -0.36787944117
/// Returns 0 for out-of-domain inputs
#define fn BL127_LAMBERT_WM1() = takes(1) returns(1) {
    // Stack: [x]
    
    // Domain check: x must be in [-1/e, 0)
    // Check x < 0
    dup1 [SIGN_MASK] and iszero lambertwm1_domain_error jumpi
    
    // Check x >= -1/e
    dup1 [INV_E_BL127] NEGATE()     // [-1/e, x]
    slt lambertwm1_domain_error jumpi
    
    // Special case: x very close to -1/e
    // At x = -1/e, W_{-1}(-1/e) = -1
    dup1 [INV_E_BL127] NEGATE()     // [-1/e, x]
    BL127_SUB()                     // [x - (-1/e), x]
    BL127_ABS()                     // [|x + 1/e|, x]
    
    // If |x + 1/e| < 0.001, return -1 (close enough to branch point)
    dup1 0x0000000000000000000000000000000000418937d5b73c0000000000000000 slt lambertwm1_branch_point jumpi
    pop                             // [x]
    
    // Initial guess: w0 = ln(-x) - ln(-ln(-x))
    // First compute -x
    dup1 NEGATE()                   // [-x, x]
    
    // Compute ln(-x)
    dup1 BL127_LN()                 // [ln(-x), -x, x]
    
    // Compute -ln(-x)
    dup1 NEGATE()                   // [-ln(-x), ln(-x), -x, x]
    
    // Compute ln(-ln(-x))
    BL127_LN()                      // [ln(-ln(-x)), ln(-x), -x, x]
    
    // w0 = ln(-x) - ln(-ln(-x))
    swap1 BL127_SUB()               // [w0, -x, x]
    swap1 pop                       // [w0, x]
    
    // Newton-Raphson refinement: 3 iterations
    dup2 LAMBERTW0_NR_STEP()        // [w1, x]
    dup2 LAMBERTW0_NR_STEP()        // [w2, x]
    dup2 LAMBERTW0_NR_STEP()        // [w3, x]
    swap1 pop                       // [w3]
    lambertwm1_done jump
    
    lambertwm1_branch_point:
    // x ≈ -1/e, return -1
    pop pop                         // []
    [ONE_BL127] NEGATE()            // [-1]
    lambertwm1_done jump
    
    lambertwm1_domain_error:
    // Out of domain, return 0
    pop 0x00
    
    lambertwm1_done:
}

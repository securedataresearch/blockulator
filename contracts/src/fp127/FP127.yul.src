    p := add(or(shl(64, sub(sub(sub(sub(h, l), lt(h, l)), mul(slt(p, 0), t)), mul(tn, p))), shr(192, l)), 0xce9b5aa8879e8c3eee6b374dcd7cb9fd9219)
    l := mul(p, t)

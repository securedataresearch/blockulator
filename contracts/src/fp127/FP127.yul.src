                    acc := add(acc, 0x447347544cd04bb6051413ea4d1d4bcdabff7514be985cca6a894b95ee67676)
                }
                default {
                    acc := add(acc, 0x4fb4c251a16898809d2dc0fe24a3d4a19174c74f129ef35c63ad512936c5f42)

    l := mul(p, t)
    h := mulmod(p, t, not(0))
    p := add(or(shl(64, sub(sub(sub(sub(h, l), lt(h, l)), mul(slt(p, 0), t)), mul(tn, p))), shr(192, l)), 0x31eedb640d39e6e5758978d026eb391eeef6c21c64)
    l := mul(p, t)
    h := mulmod(p, t, not(0))

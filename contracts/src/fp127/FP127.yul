                y := shr(1, add(y, div(z, y)))
                y := shr(1, add(y, div(z, y)))
                y := shr(1, add(y, div(z, y)))
                y := shr(1, add(y, div(z, y)))
                y := shr(1, add(y, div(z, y)))
                y := shr(1, add(y, div(z, y)))

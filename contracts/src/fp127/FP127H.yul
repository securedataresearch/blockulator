                v := 0x1000000000000000000000000000000000000000000000000
                let l := 0
                let h := 0
                for {} gt(k, 1) { k := sub(k, 1) } {
                    l := mul(xs, v)
                    h := mulmod(xs, v, not(0))
                    v := add(0x1000000000000000000000000000000000000000000000000, sdiv(or(shl(64, sub(sub(sub(h, l), lt(h, l)), mul(slt(xs, 0), v))), shr(192, l)), k))

                if iszero(x) { r := 0 leave }
                let ax := absw(x)
                if gt(ax, 0x5800000000000000000000000000000000) { rev(0x35278d12) }
                if lt(ax, 0x8000000000000000) { r := x leave }
                let n, sh, sl := expx(ax)
                let vh, vl := sc192(sub(n, 1), sh, sl)
                let w := einvhalf(n, sh)
                r := rnd192(sub(vh, lt(vl, w)), sub(vl, w))

                if lt(ax, 0x10000000000000000) { r := 0x100000000000000000000000000000000 leave }
                let n, sh, sl := expx(ax)
                let vh, vl := sc192(sub(n, 1), sh, sl)
                let l := add(vl, einvhalf(n, sh))
                r := rnd192(add(vh, lt(l, vl)), l)

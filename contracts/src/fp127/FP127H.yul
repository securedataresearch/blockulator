                { let pl := mul(r, x) let ph := mulmod(r, x, not(0)) r := add(sub(sub(sub(ph, pl), lt(ph, pl)), mul(slt(r, 0), x)), 0x24eed8a1df37fcf2594e66295cdbcc9e76ef3c7e001462107e6acaff595ad672) }

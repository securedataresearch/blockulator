            function log2g(x) -> r {
                let m := msb(x)
                if iszero(and(x, sub(x, 1))) { r := shl(192, sub(m, 128)) leave }
                let mm := shl(sub(192, m), x)
                if gt(m, 192) { mm := shr(sub(m, 192), x) }
                r := add(shl(192, sub(m, 128)), log2m(mm))

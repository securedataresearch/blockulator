                if sgt(e, 0x7ffff) { rev(0x35278d12) }
                if slt(e, 1) { r := 0 leave }
                r := or(shl(255, s), or(shl(236, e), and(m, 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)))
            }


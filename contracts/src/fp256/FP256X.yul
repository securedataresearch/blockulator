                let lo := mul(x1l, m)
                let mm := mulmod(x1l, m, not(0))
                nl := shr(237, lo)
                let c := sub(sub(mm, lo), lt(mm, lo))
                lo := mul(x1h, m)
                mm := mulmod(x1h, m, not(0))
                mm := sub(sub(mm, lo), lt(mm, lo))
                lo := add(lo, c)
                nh := or(shl(19, add(mm, lt(lo, c))), shr(237, lo))
                nl := or(shl(19, lo), nl)

            function wexpr(s, kk, xh, xl) -> k2, eh, el {
                let ph, pl := kln2(absw(kk))
                let rh := 0
                let rl := 0
                switch s
                case 0 { rh, rl := wsub(xh, xl, ph, pl) }
                default { rh, rl := wsub(ph, pl, xh, xl) }

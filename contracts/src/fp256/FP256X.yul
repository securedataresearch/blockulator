                qh, ql := wrecip(ah, al)
                let bh, bl, eb := cfrun(1, m, sa, n)
                let tb := 0
                bh, bl, tb := wnorm(bh, bl)
                qh, ql := wmul(qh, ql, bh, bl)
                qh, ql := wshr(qh, ql, 1)
                t := add(sub(add(eb, ta), add(ea, tb)), 1)

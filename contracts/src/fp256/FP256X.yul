            function mulwr(a, b) -> r {
                let p1, p0 := mul512(a, b)
                p1 := sub(p1, mul(slt(a, 0), b))
                p1 := sub(p1, mul(slt(b, 0), a))
                r := add(or(shl(2, p1), shr(254, p0)), and(shr(253, p0), 1))
            }


            function mul3(h, l, m) -> n2, n1, n0 {
                let a1, a0 := mul512(h, m)
                let b1 := 0
                b1, n0 := mul512(l, m)
                n1 := add(a0, b1)
                n2 := add(a1, lt(n1, a0))
            }

            function shr3(z2, z1, z0, n) -> rh, rl {
                if lt(n, 256) {
                    rh := or(shl(sub(256, n), z2), shr(n, z1))
                    rl := or(shl(sub(256, n), z1), shr(n, z0))
                    leave
                }
                rh, rl := wshr(z2, z1, sub(n, 256))

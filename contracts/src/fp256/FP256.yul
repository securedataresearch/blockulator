            function lnw3(u, lh, ll) -> r {
                let p2, p1, p0 := kln2x(absw(u))
                switch slt(u, 0)
                case 0 {
                    p0 := add(p0, ll)
                    let c := lt(p0, ll)
                    p1 := add(p1, lh)

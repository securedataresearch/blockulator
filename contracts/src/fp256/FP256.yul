            function wsub(ah, al, bh, bl) -> rh, rl {
                rl := sub(al, bl)
                rh := sub(sub(ah, bh), lt(al, bl))
            }

            function wshr(h, l, n) -> rh, rl {
                switch lt(n, 256)
                case 1 {
                    rh := shr(n, h)
                    rl := or(shl(sub(256, n), h), shr(n, l))
                }
                default { rl := shr(sub(n, 256), h) }

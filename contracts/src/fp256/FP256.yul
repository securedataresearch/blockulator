            function pow2kv(Lm, Ls, s, ey, my) -> z, kk, v, k {
                let p1, p0 := mul512(Lm, my)
                // |t| = (p1, p0) 2^(Ls + uy - 236); at 2^-254 a shift right by q - 254
                let q := sub(236, add(Ls, sub(ey, 0x3ffff)))
                if slt(q, 254) {
                    if s { z := 1 leave }
                    rev(0x35278d12)
                }
                k := shr512(p1, p0, q)

                let W1 := div254(shl(254, 1), y2)
                let w := shr(add(ey, 1), W1)
                let term := shr(sub(ey, 7), W1)
                let T := sub(0, term)
                for { let mm := 3 } term { mm := add(mm, 2) } {
                    term := mulwu(term, mul(mm, w))
                    switch and(mm, 2)
                    case 2 { T := add(T, term) }
                    default { T := sub(T, term) }

                p0 := mul(ah, bl)
                mm := mulmod(ah, bl, not(0))
                let q1 := sub(sub(mm, p0), lt(mm, p0))
                let t0 := mul(al, bh)
                mm := mulmod(al, bh, not(0))
                q1 := add(q1, sub(sub(mm, t0), lt(mm, t0)))
                t0 := add(p0, t0)
                q1 := add(q1, lt(t0, p0))
                p0 := or(shl(2, q1), shr(254, t0))

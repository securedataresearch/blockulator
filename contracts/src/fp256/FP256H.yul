            function round2(s, e, h, l) -> r {
                if h {
                    let k := add(msb(h), 1)
                    r := normround(s, add(e, k), or(shl(sub(256, k), h), shr(k, l)))
                    leave
                }
                r := normround(s, e, l)
            }

            function round3(s, e, n2, n1, n0) -> r {
                if n2 {
                    let k := add(msb(n2), 1)
                    r := normround(s, add(e, add(256, k)), or(shl(sub(256, k), n2), shr(k, n1)))
                    leave

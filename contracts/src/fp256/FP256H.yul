            function rbad(D, err) -> b {
                let w := sub(msb(D), 236)
                if slt(w, 2) {
                    b := 1
                    leave
                }
                let half := shl(sub(w, 1), 1)
                let low := and(D, sub(shl(w, 1), 1))
                let d := sub(low, half)
                if lt(low, half) { d := sub(half, low) }
                b := iszero(gt(d, err))
            }

            function mulhi(a, b) -> h {
                let mm := mulmod(a, b, not(0))
                let lo := mul(a, b)
                h := sub(sub(mm, lo), lt(mm, lo))

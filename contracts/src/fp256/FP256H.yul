            function wdivs(h, l, k) -> qh, ql {
                qh := div(h, k)
                let x := or(shl(128, mod(h, k)), shr(128, l))
                let q1 := div(x, k)
                x := or(shl(128, mod(x, k)), and(l, 0xffffffffffffffffffffffffffffffff))
                ql := or(shl(128, q1), div(x, k))
